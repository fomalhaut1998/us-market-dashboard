# 复制为 .env.local 后填写。全部留空也能启动，但缺少 key 的对应数据会显示「暂无数据」。
# Twelve Data：用于 SPY、QQQ、DIA、SOXX、IWM、纳斯达克综合指数和优先 VIX 日线
TWELVE_DATA_API_KEY=

# 如账户中的纳斯达克综合指数或 VIX 代码不同，可在此覆盖默认的 IXIC / VIX
TWELVE_DATA_NASDAQ_SYMBOL=IXIC
TWELVE_DATA_VIX_SYMBOL=VIX

# Financial Modeling Prep：Twelve Data 无法提供纳斯达克综合指数时，以 ^IXIC 回退
FMP_API_KEY=

# FRED：高收益债 OAS（BAMLH0A0HYM2）。免费申请 https://fredaccount.stlouisfed.org/apikeys
# 不填则回退到 fredgraph.csv 端点，该端点经常排队超时，信用卡片会显示「暂无数据」
FRED_API_KEY=

# 标普500月度 PE 与近5年分位从 Multpl 服务端页面获取，无需 API Key

# 可选：倍率轨迹快照文件路径，默认 <项目根>/data/snapshots.jsonl
# 部署到只读文件系统（如 Vercel）时，指向可写目录，例如 /tmp/us-market-snapshots.jsonl。
# 注意：临时目录在实例重启后会清空，倍率轨迹不会长期保留。
# DASHBOARD_SNAPSHOT_FILE=
